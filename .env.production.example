# ============================================================================
# FurOfTheWeak — PRODUCTION Environment Configuration
# Copy this file to `.env.production` on the VPS and fill in real values.
# Never commit the real `.env.production` file (see .gitignore).
#
# Used with docker-compose.prod.yml — see docs/DEPLOY_VPS.md for the full
# walkthrough. Every ${VAR}-style placeholder below marked "generate a real
# value" needs one; a `change-me` left in place in production is a real
# security hole, not a placeholder.
# ============================================================================

# --- App -------------------------------------------------------------------
APP_NAME=FurOfTheWeak
APP_ENV=production
APP_DEBUG=false
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=change-me-generate-a-real-random-64-char-string
APP_BASE_URL=https://YOUR_DOMAIN_HERE
FRONTEND_BASE_URL=https://YOUR_DOMAIN_HERE
TRACKING_BASE_URL=https://YOUR_DOMAIN_HERE

# Set to false once you've actually configured a real IP/reputation/email
# provider above — true is the safe default until you do.
USE_MOCK_PROVIDERS=true

# --- Database ----------------------------------------------------------------
POSTGRES_USER=furoftheweak
# Generate with: openssl rand -hex 24 — do not reuse the dev placeholder.
POSTGRES_PASSWORD=change-me-generate-a-real-random-password
POSTGRES_DB=furoftheweak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://furoftheweak:change-me-generate-a-real-random-password@postgres:5432/furoftheweak

# --- Redis (cache, rate limiting, and the background job queue) ------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT --------------------------------------------------------------
# Generate with: openssl rand -hex 32 — must differ from APP_SECRET_KEY.
JWT_SECRET_KEY=change-me-generate-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- CORS ---------------------------------------------------------------------
# Restrict to the real deployed origin — never leave this as a wildcard or
# a localhost dev origin in production.
CORS_ORIGINS=https://YOUR_DOMAIN_HERE

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_REDIRECT_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=60

# API key tiers (requests/day) — spec section 21
RATE_LIMIT_API_KEY_FREE_PER_DAY=100
RATE_LIMIT_API_KEY_PRO_PER_DAY=10000
RATE_LIMIT_API_KEY_BUSINESS_PER_DAY=100000

# --- Webhooks ------------------------------------------------------------------
WEBHOOK_MAX_RETRY_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=8

# --- Background worker -----------------------------------------------------
WORKER_SWEEP_INTERVAL_SECONDS=60

# --- Security Center ---------------------------------------------------------
SECURITY_SCAN_ALERT_THRESHOLD=60

# --- Seed / bootstrap ----------------------------------------------------------
# The auto-seeded admin account is disabled entirely when APP_ENV=production
# (see backend/scripts/seed.py) — this value is unused in prod. Create your
# first admin by registering normally, then promoting that user's role to
# SUPER_ADMIN directly in the database.
SEED_ADMIN_EMAIL=admin@YOUR_DOMAIN_HERE

# --- IP Intelligence provider (adapter pattern; provider is swappable) ------
IP_PROVIDER=mock             # mock | ipinfo | ipapi
IP_INTELLIGENCE_API_KEY=
IP_INTELLIGENCE_BASE_URL=
IP_INTELLIGENCE_TIMEOUT_SECONDS=8
IP_INTELLIGENCE_FALLBACK_PROVIDER=local

# --- URL/domain reputation provider (adapter pattern, Phase 13+) -----------
REPUTATION_PROVIDER=mock
REPUTATION_API_KEY=

# --- Email provider (adapter pattern) --------------------------------------
EMAIL_PROVIDER=mock          # mock | smtp — switch to smtp for real password-reset/verification emails
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN_HERE
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Map provider (adapter pattern, used by frontend approximate-location map) -
MAP_PROVIDER=maplibre-demo
MAP_API_KEY=

# --- Feature flags -------------------------------------------------------------
ENABLE_QR=true
ENABLE_WEBHOOK=true
ENABLE_REALTIME=false
ENABLE_DOMAIN_ANALYZER=true
ENABLE_AI=false
ENABLE_DEVICE_CONTROL=false

# --- Device control / TURN (coturn) -----------------------------------------
# Only needed if you turn ENABLE_DEVICE_CONTROL on. Browsers connect to
# coturn directly (not through nginx), so TURN_SERVER_URL must be this
# server's real public domain/IP, not "localhost".
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=change-me-generate-a-real-random-string
TURN_REALM=YOUR_DOMAIN_HERE
TURN_SERVER_URL=turn:YOUR_DOMAIN_HERE:3478
STUN_SERVER_URL=stun:stun.l.google.com:19302
DEVICE_PAIRING_CODE_TTL_SECONDS=300
DEVICE_SESSION_MAX_DURATION_SECONDS=3600
DEVICE_WS_TICKET_TTL_SECONDS=60
