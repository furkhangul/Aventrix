# ============================================================================
# FurOfTheWeak — Environment Configuration
# Copy this file to `.env` in the repo root and fill in values as needed.
# Never commit the real `.env` file. Missing provider keys never crash the
# app — the affected integration just reports itself as "not configured".
# ============================================================================

# --- App -------------------------------------------------------------------
APP_NAME=FurOfTheWeak
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Base URL used to build short tracking links, e.g. https://domain.com/t/ABC123
TRACKING_BASE_URL=http://localhost:8000

# When true, every external integration below uses its mock/local provider
# regardless of whether a key is configured. Recommended for local dev.
USE_MOCK_PROVIDERS=true

# --- Database ----------------------------------------------------------------
POSTGRES_USER=furoftheweak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=furoftheweak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://furoftheweak:change-me@postgres:5432/furoftheweak

# --- Redis (cache, rate limiting, and the background job queue) ------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false          # set true in production (HTTPS only)
COOKIE_DOMAIN=

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_REDIRECT_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=60

# API key tiers (requests/day) — spec section 21
RATE_LIMIT_API_KEY_FREE_PER_DAY=100
RATE_LIMIT_API_KEY_PRO_PER_DAY=10000
RATE_LIMIT_API_KEY_BUSINESS_PER_DAY=100000

# --- Webhooks ------------------------------------------------------------------
WEBHOOK_MAX_RETRY_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=8

# --- Background worker -----------------------------------------------------
# How often (seconds) the worker sweeps for due webhook retries and expired links.
WORKER_SWEEP_INTERVAL_SECONDS=60

# --- Security Center ---------------------------------------------------------
# Scan scores below this trigger a security.alert webhook + notification.
SECURITY_SCAN_ALERT_THRESHOLD=60

# --- Seed / bootstrap ----------------------------------------------------------
# If set, the seed script creates this admin account with a RANDOMLY
# GENERATED password printed once to the console. Never hardcode a password.
SEED_ADMIN_EMAIL=admin@furoftheweak.local

# --- IP Intelligence provider (adapter pattern; provider is swappable) ------
IP_PROVIDER=mock             # mock | ipinfo | ipapi
IP_INTELLIGENCE_API_KEY=
IP_INTELLIGENCE_BASE_URL=
IP_INTELLIGENCE_TIMEOUT_SECONDS=8
IP_INTELLIGENCE_FALLBACK_PROVIDER=local

# --- URL/domain reputation provider (adapter pattern, Phase 13+) -----------
REPUTATION_PROVIDER=mock
REPUTATION_API_KEY=

# --- Email provider (adapter pattern) --------------------------------------
EMAIL_PROVIDER=mock          # mock | smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@furoftheweak.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Map provider (adapter pattern, used by frontend approximate-location map) -
MAP_PROVIDER=maplibre-demo
MAP_API_KEY=

# --- Feature flags -------------------------------------------------------------
ENABLE_QR=true
ENABLE_WEBHOOK=true
ENABLE_REALTIME=false
ENABLE_DOMAIN_ANALYZER=true
ENABLE_AI=false
ENABLE_DEVICE_CONTROL=false

# --- Device control / TURN (coturn) -----------------------------------------
# Remote screen control (Devices module, see docs/DEVICE_CONTROL_PROTOCOL.md).
# Off by default. Requires the `coturn` service in docker-compose.yml for
# reliable NAT traversal between a phone and a browser on different networks
# — there's no meaningful mock for TURN, so on your own network a same-LAN
# connection can still work via STUN alone even without coturn relaying.
TURN_SHARED_SECRET=change-me-to-a-random-string
TURN_REALM=furoftheweak.local
TURN_SERVER_URL=turn:localhost:3478
STUN_SERVER_URL=stun:stun.l.google.com:19302
DEVICE_PAIRING_CODE_TTL_SECONDS=300
DEVICE_SESSION_MAX_DURATION_SECONDS=3600
DEVICE_WS_TICKET_TTL_SECONDS=60
